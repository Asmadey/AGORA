# ─── AGORA environment ───────────────────────────────────────────────
# Copy to .env.local and fill in real values. NEVER commit real keys.
# Контракт провайдера — Decision Log #1: Qwen 3.6 (мультимодальная, текст+кадры→JSON)
# через OpenAI-совместимый API timeweb.cloud. GPU не нужен, модели по API.
# Прежний вариант с Google Gemini (@google/genai) выпиливается на задаче #1.

# ─── Модели: Qwen через OpenAI-совместимый endpoint timeweb ──────────
# Один провайдер обслуживает и рассуждение персон, и VLM-разбор кадров.
OPENAI_API_KEY="your-timeweb-key"
OPENAI_BASE_URL="https://api.timeweb.cloud/v1"   # уточнить точный baseURL по кабинету
AI_MODEL="qwen3.6"                 # рассуждение персон, аналитика, QA, чат
VLM_MODEL="qwen3.6"                # разбор панелей кадров → JSON сцены

# ─── STT / диаризация: self-host на VPS (CPU) ────────────────────────
WHISPER_MODEL="large-v3"           # large-v3 | large-v3-turbo (переключается в Настройках)
WHISPER_COMPUTE_TYPE="int8"
PYANNOTE_TOKEN="your-hf-token"     # pyannote 3.1, диаризация по полному треку

# ─── Хранилища ───────────────────────────────────────────────────────
# ВАЖНО: приложение подключается ролью agora_login, а НЕ суперпользователем.
# RLS не действует на суперпользователя — под postgres изоляции арендаторов нет
# вообще. Роли заводит infra/postgres/init/04_login_role.sh.
POSTGRES_USER="agora"                  # суперпользователь, только миграции
POSTGRES_PASSWORD="сгенерируйте"       # openssl rand -base64 24
POSTGRES_DB="agora"
AGORA_APP_PASSWORD="сгенерируйте"      # пароль agora_login — рабочая роль приложения
AGORA_SHARE_PASSWORD="сгенерируйте"    # пароль agora_share_login — публичные ссылки

DATABASE_URL="postgresql://agora_login:ПАРОЛЬ@host:5432/agora"   # PostgreSQL 18 + RLS

MONGO_USER="agora"
MONGO_PASSWORD="сгенерируйте"
MONGO_DB="agora"
MONGODB_URL="mongodb://agora:ПАРОЛЬ@host:27017/agora?authSource=admin"   # MongoDB 8.0

VALKEY_URL="redis://host:6379/0"                         # Valkey 9.1 (очередь/прогресс/кэш)

S3_ENDPOINT="https://s3.timeweb.cloud"
S3_BUCKET="agora-media"
S3_ACCESS_KEY="your-s3-access-key"
S3_SECRET_KEY="your-s3-secret-key"

# ─── Auth.js (self-host, «команда = арендатор») ──────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Public URL — self-links, callbacks, публичные ссылки шеринга отчётов (#29).
APP_URL="http://localhost:3000"
