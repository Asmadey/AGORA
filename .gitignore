# ⚠️ СЕКРЕТЫ — не коммитить. env.env содержит живой ключ провайдера.
# Паттерн `.env*` в agora-unified/.gitignore файл `env.env` НЕ ловит (нет ведущей точки),
# поэтому он перечислен здесь явно. Лучше вообще вынести его за пределы репозитория.
env.env
*.env
.env
.env.*
!.env.example
!*.env.example

# Артефакты сборки и рантайма
node_modules/
.next/
coverage/
dist/
build/
__pycache__/
*.pyc

# Локальные артефакты верификатора (генерируются прогоном, не версионируются)
#
# Пути после переезда в монорепо (задача #1). Прежние правила указывали на
# agora-unified/evals/ и после переезда не закрывали ничего — то есть артефакты
# прогона были открыты для git всё это время.
#
# Опаснее, чем просто мусор в истории: check.py читает persona_answers.json и
# generated_personas.json как результат ПРОГОНА. Закоммиченный артефакт делает
# метрику ответом на давний чужой запуск, и она либо зеленеет без оснований,
# либо краснеет на чужой фикстуре — оба исхода неотличимы от настоящего.
evals/artifacts/
evals/last_report.json
agora-unified/evals/artifacts/
agora-unified/evals/last_report.json

# Медиа-фикстуры крупнее пары мегабайт держать в S3/LFS, не в git
# agora-unified/evals/fixtures/*.mp4

# Системное
.DS_Store
*.log

# Инкрементальный кеш TypeScript — машинный артефакт, в репозитории не нужен
*.tsbuildinfo

# Анкеты живых респондентов (docs/quiz/) — персональные данные. Исходные XLSX/DOCX
# не хранятся в git; в репозитории только обезличенный корпус
# data/grounding/unified_respondent_sessions.json (задача #23, вариант А).
# Файлы остаются в истории до очистки filter-repo/BFG — см. loop-state blockers.
docs/quiz/

# DMARC-отчёты почтовых провайдеров: их роняет в каталог почтовый клиент,
# к проекту они отношения не имеют и содержат домен и IP отправителей.
*.xml
!infra/**/*.xml

# Отчёт верификатора — артефакт прогона, а не исходник. Перезаписывается каждым
# запуском evals/check.py, поэтому в отслеживании порождает шумные коммиты и
# конфликты между агентами. CI генерирует его сам перед чтением.
evals/last_report.json

# Видео для тестов: 39 МБ на файл, история необратима (§6-бис CLAUDE.md).
docs/video/

# Каталог навыков помощника — к продукту отношения не имеет.
skills/









